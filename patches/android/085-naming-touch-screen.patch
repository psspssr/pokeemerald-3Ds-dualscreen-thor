+}
+
+static bool8 CtrNaming_AcceptsTap(void)
+{
+    u8 taskId;
+
+    if (!CtrNaming_IsOpen() || gPaletteFade.active)
+        return FALSE;
+    if (sNamingScreen->state == STATE_WAIT_SENT_TO_PC_MESSAGE)
+        return !IsTextPrinterActive(0);
+    taskId = FindTaskIdByFunc(Task_HandleInput);
+    return taskId != TASK_NONE && sNamingScreen->state == STATE_HANDLE_INPUT
+        && gTasks[taskId].data[0] == INPUT_STATE_ENABLED;
+}
+
+void CtrNaming_Tap(s16 x, s16 y)
+{
+    sCtrNamingTap.pending = FALSE;
+    if (!CtrNaming_AcceptsTap() || x < 0 || x >= DISPLAY_WIDTH || y < 0 || y >= DISPLAY_HEIGHT)
+        return;
+    sCtrNamingTap.pending = TRUE;
+    sCtrNamingTap.x = x;
+    sCtrNamingTap.y = y;
+    sCtrNamingTap.page = sNamingScreen->currentPage;
+    sCtrNamingTap.state = sNamingScreen->state;
+    sCtrNamingTap.frame = gMain.vblankCounter1;
+}
+
+static bool8 CtrNaming_TakeTap(s16 *x, s16 *y)
+{
+    if (!sCtrNamingTap.pending)
+        return FALSE;
+    sCtrNamingTap.pending = FALSE;
+    if (!CtrNaming_AcceptsTap() || sCtrNamingTap.page != sNamingScreen->currentPage
+        || sCtrNamingTap.state != sNamingScreen->state
+        || gMain.vblankCounter1 - sCtrNamingTap.frame > 30)
+        return FALSE;
+    *x = sCtrNamingTap.x;
+    *y = sCtrNamingTap.y;
+    return TRUE;
+}
+
+static bool8 CtrNaming_Acknowledge(void)
+{
+    s16 x, y;
+    return CtrNaming_TakeTap(&x, &y);
+}
+
+// Select the displayed key, then let the unchanged native keyboard handler
+// perform its normal character, page, backspace or OK action.
+static bool8 CtrNaming_TouchInput(struct Task *task)
+{
+    s16 x, y, column, row;
+    u8 page;
+
+    if (!CtrNaming_TakeTap(&x, &y))
+        return FALSE;
+    if (x >= 184 && x < 224 && y >= 72 && y < 152)
+    {
+        column = GetCurrentPageColumnCount();
+        row = y < 104 ? BUTTON_PAGE : y < 128 ? BUTTON_BACK : BUTTON_OK;
+    }
+    else
+    {
+        if (y < 80 || y >= 144)
+            return FALSE;
+        page = CurrentPageToKeyboardId();
+        for (column = 0; column < GetCurrentPageColumnCount(); ++column)
+        {
+            s16 center = 38 + sPageColumnXPos[page][column];
+            s16 radius = page == KEYBOARD_SYMBOLS ? 10 : 6;
+            if (x >= center - radius && x < center + radius)
+                break;
+        }
+        if (column == GetCurrentPageColumnCount())
+            return FALSE; // decorative gaps between the letter groups
+        row = (y - 80) / 16;
+        task->data[2] = row; // preserve D-pad return from the button column
+    }
+    SetCursorPos(column, row);
+    task->data[1] = INPUT_A_BUTTON;
+    return TRUE;
+}
