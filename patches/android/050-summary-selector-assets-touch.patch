 void CtrSummary_Tap(s16 x, s16 y)
 {
+    if (gMain.callback2 != MainCB2 || sMonSummaryScreen == NULL
+        || (sMonSummaryScreen->mode == SUMMARY_MODE_SELECT_MOVE
+            && (gPaletteFade.active || MenuHelpers_ShouldWaitForLinkRecv() == TRUE
+                || FuncIsActiveTask(Task_ShowPowerAccWindow)
+                || (!FuncIsActiveTask(Task_HandleReplaceMoveInput)
+                    && !FuncIsActiveTask(Task_HandleInputCantForgetHMsMoves)))))
+    {
+        sCtrTap.pending = FALSE;
+        return;
+    }
     sCtrTap.pending = TRUE;
     sCtrTap.x = x;
     sCtrTap.y = y;
     sCtrTap.frame = gMain.vblankCounter1;
+}
+
+enum CtrSummaryMoveTouch
+{
+    CTR_MOVE_TOUCH_NONE = -1, CTR_MOVE_TOUCH_OK = -2, CTR_MOVE_TOUCH_BACK = -3,
+    CTR_MOVE_TOUCH_PREV = -4, CTR_MOVE_TOUCH_NEXT = -5,
+};
+
+static s16 CtrSummary_MoveTouchChoice(void)
+{
+    s16 x = sCtrTap.x, y = sCtrTap.y;
+    if (!sCtrTap.pending)
+        return CTR_MOVE_TOUCH_NONE;
+    sCtrTap.pending = FALSE;
+    if (gMain.callback2 != MainCB2 || sMonSummaryScreen == NULL
+        || sMonSummaryScreen->mode != SUMMARY_MODE_SELECT_MOVE
+        || gPaletteFade.active || MenuHelpers_ShouldWaitForLinkRecv() == TRUE
+        || FuncIsActiveTask(Task_ShowPowerAccWindow)
+        || gMain.vblankCounter1 - sCtrTap.frame > 30
+        || x < 0 || x >= DISPLAY_WIDTH || y < 0 || y >= DISPLAY_HEIGHT)
+        return CTR_MOVE_TOUCH_NONE;
+    if (y < 16 && x >= 176)
+        return x < 208 ? CTR_MOVE_TOUCH_OK : CTR_MOVE_TOUCH_BACK;
+    if (y < 16 && x >= 86 && x < 150)
+    {
+        s16 page = (x - 86) / 16;
+        if (page >= sMonSummaryScreen->minPageIndex && page <= sMonSummaryScreen->maxPageIndex
+            && page != sMonSummaryScreen->currPageIndex)
+            return page < sMonSummaryScreen->currPageIndex ? CTR_MOVE_TOUCH_PREV : CTR_MOVE_TOUCH_NEXT;
+    }
+    if (x >= 80 && y >= 32 && y < 112)
+    {
+        s16 row = (y - 32) / 16;
+        if (row == MAX_MON_MOVES || sMonSummaryScreen->summary.moves[row] != MOVE_NONE)
+            return row;
+    }
+    return CTR_MOVE_TOUCH_NONE;
+}
+
+static u16 CtrSummary_MoveTouchKeys(s16 choice)
+{
+    switch (choice)
+    {
+    case CTR_MOVE_TOUCH_OK: return A_BUTTON;
+    case CTR_MOVE_TOUCH_BACK: return B_BUTTON;
+    case CTR_MOVE_TOUCH_PREV: return DPAD_LEFT;
+    case CTR_MOVE_TOUCH_NEXT: return DPAD_RIGHT;
+    default: return 0;
+    }
+}
+
+static void CtrSummary_SelectTouchedMove(u8 taskId, s16 row, bool8 warning)
+{
+    s16 *data = gTasks[taskId].data;
+    // A row tap only previews. OK (or A) confirms through the existing rules.
+    if (warning && row == sMonSummaryScreen->firstMoveIndex)
+        return;
+    data[0] = MAX_MON_MOVES;
+    if (warning)
+        data[1] = 1;
+    for (unsigned step = 0; step <= MAX_MON_MOVES && sMonSummaryScreen->firstMoveIndex != row; ++step)
+        ChangeSelectedMove(data, 1, &sMonSummaryScreen->firstMoveIndex);
+    KeepMoveSelectorVisible(SPRITE_ARR_ID_MOVE_SELECTOR1);
+    if (warning)
+    {
+        data[1] = 0;
+        gTasks[taskId].func = Task_HandleReplaceMoveInput;
+    }
 }
 
