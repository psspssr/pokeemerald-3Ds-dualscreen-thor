+/* Save warnings include multiple game-text pages. Expand without writing
+ * past the CPU menu's buffer, including nested player/string placeholders. */
+static bool8 AppendSaveMessage(u8 **out, unsigned *remaining, const u8 *text, unsigned depth)
+{
+    if (text == NULL || depth > 8)
+        return FALSE;
+    text = Port_ResolveTextPointer(text);
+    if (text == NULL)
+        return FALSE;
+    while (*text != EOS)
+    {
+        if (*text == PLACEHOLDER_BEGIN)
+        {
+            ++text;
+            if (*text == EOS || !AppendSaveMessage(out, remaining, GetExpandedPlaceholder(*text++), depth + 1))
+                return FALSE;
+        }
+        else
+        {
+            unsigned count = 1;
+            if (*text == EXT_CTRL_CODE_BEGIN)
+            {
+                if (text[1] == EOS)
+                    return FALSE;
+                count += GetExtCtrlCodeLength(text[1]);
+                if (count == 1)
+                    return FALSE;
+                /* Save text never uses EOS as a control argument. Stop at
+                 * a truncated control instead of reading past its string. */
+                for (unsigned i = 1; i < count; ++i)
+                    if (text[i] == EOS) return FALSE;
+            }
+            if (count > *remaining)
+                return FALSE;
+            memcpy(*out, text, count);
+            *out += count;
+            *remaining -= count;
+            text += count;
+        }
+    }
+    return TRUE;
+}
+
+static void SetSaveMessage(const u8 *text)
+{
+    u8 *out = sSaveMessage;
+    unsigned remaining = sizeof(sSaveMessage) - 1;
+    bool8 complete = AppendSaveMessage(&out, &remaining, text, 0);
+
+    *out = EOS;
+    if (!complete)
+    {
+        CtrLog_Write(CTR_LOG_ERROR, "bottom Save message exceeds capacity or has invalid controls");
+        CopyText(sSaveMessage, sizeof(sSaveMessage), Ascii("Save message unavailable."));
+        /* Never offer Yes for an incomplete overwrite warning. */
+        sSaveStep = SAVE_DONE;
+    }
+}
