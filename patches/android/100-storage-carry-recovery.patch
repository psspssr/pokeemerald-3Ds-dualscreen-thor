+// A child screen frees the PC UI while a single Pokémon or item may still
+// be in the cursor. Keep the unfinished move outside the fallible heap.
+// Completed moves commit this checkpoint; init failure rolls back only the
+// current move. Box names/wallpapers, world state and playtime are not copied.
+struct StorageCarryCheckpoint
+{
+    bool8 active;
+    u16 bagKey;
+    struct Pokemon party[PARTY_SIZE];
+    struct BoxPokemon boxes[TOTAL_BOXES_COUNT][IN_BOX_COUNT];
+    struct ItemSlot bagPocket_Items[BAG_ITEMS_COUNT];
+    struct ItemSlot bagPocket_KeyItems[BAG_KEYITEMS_COUNT];
+    struct ItemSlot bagPocket_PokeBalls[BAG_POKEBALLS_COUNT];
+    struct ItemSlot bagPocket_TMHM[BAG_TMHM_COUNT];
+    struct ItemSlot bagPocket_Berries[BAG_BERRIES_COUNT];
+    struct Mail mail[MAIL_COUNT];
+};
+STATIC_ASSERT(sizeof(struct StorageCarryCheckpoint) <= 40 * 1024, storage_carry_checkpoint_budget);
+EWRAM_DATA static struct StorageCarryCheckpoint sStorageCarry = {0};
+EWRAM_DATA static bool8 sStorageCarryRecovered = FALSE;
+EWRAM_DATA static bool8 sStorageInitFailed = FALSE;
+static const u8 sText_StorageMemoryFull[] = _("The PC could not open.\nPlease try again.");
+static const u8 sText_StorageCarryRecovered[] = _("The PC could not reopen.\nUnfinished move was undone.");
+
+static void CtrStorageCarry_Begin(void)
+{
+    if (sStorageCarry.active)
+        return;
+    memcpy(sStorageCarry.party, gPlayerParty, sizeof(sStorageCarry.party));
+    memcpy(sStorageCarry.boxes, gPokemonStoragePtr->boxes, sizeof(sStorageCarry.boxes));
+#define SNAPSHOT(member) memcpy(sStorageCarry.member, gSaveBlock1Ptr->member, sizeof(sStorageCarry.member))
+    SNAPSHOT(bagPocket_Items);
+    SNAPSHOT(bagPocket_KeyItems);
+    SNAPSHOT(bagPocket_PokeBalls);
+    SNAPSHOT(bagPocket_TMHM);
+    SNAPSHOT(bagPocket_Berries);
+    SNAPSHOT(mail);
+#undef SNAPSHOT
+    sStorageCarry.bagKey = (u16)gSaveBlock2Ptr->encryptionKey;
+    sStorageCarry.active = TRUE;
+}
+
+static void CtrStorageCarry_Commit(void)
+{
+    sStorageCarry.active = FALSE;
+}
+
+static void CtrStorageCarry_RestorePocket(struct ItemSlot *dest, const struct ItemSlot *src, u32 count)
+{
+    u32 i;
+    u16 keyChange = sStorageCarry.bagKey ^ (u16)gSaveBlock2Ptr->encryptionKey;
+    for (i = 0; i < count; i++)
+    {
+        dest[i].itemId = src[i].itemId;
+        dest[i].quantity = src[i].quantity ^ keyChange;
+    }
+}
+
+static void CtrStorageCarry_Rollback(void)
+{
+    if (!sStorageCarry.active)
+        return;
+    memcpy(gPlayerParty, sStorageCarry.party, sizeof(sStorageCarry.party));
+    memcpy(gPokemonStoragePtr->boxes, sStorageCarry.boxes, sizeof(sStorageCarry.boxes));
+#define RESTORE(member) CtrStorageCarry_RestorePocket(gSaveBlock1Ptr->member, sStorageCarry.member, ARRAY_COUNT(sStorageCarry.member))
+    RESTORE(bagPocket_Items);
+    RESTORE(bagPocket_KeyItems);
+    RESTORE(bagPocket_PokeBalls);
+    RESTORE(bagPocket_TMHM);
+    RESTORE(bagPocket_Berries);
+#undef RESTORE
+    memcpy(gSaveBlock1Ptr->mail, sStorageCarry.mail, sizeof(sStorageCarry.mail));
+    gPlayerPartyCount = CalculatePlayerPartyCount();
+    sIsMonBeingMoved = FALSE;
+    sMovingItemId = ITEM_NONE;
+    memset(&sSavedMovingMon, 0, sizeof(sSavedMovingMon));
+    sStorageCarry.active = FALSE;
+    sStorageCarryRecovered = TRUE;
+}
+
+static void CtrStorageCarry_InitFailed(void)
+{
+    sStorageInitFailed = TRUE;
+    CtrStorageCarry_Rollback();
+}
+
