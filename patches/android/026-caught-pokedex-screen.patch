+/* The registration page is driven by battle tasks, not CB2_Pokedex. Its
+ * full 160 rows must bypass the battle scene's 112-row crop until the exit
+ * task has finished fading the page and moving the caught sprite. */
+bool8 CtrPokedex_CaughtPageIsOpen(void)
+{
+    return FuncIsActiveTask(Task_DisplayCaughtMonDexPage)
+        || FuncIsActiveTask(Task_HandleCaughtMonPageInput)
+        || FuncIsActiveTask(Task_ExitCaughtMonPage);
+}
