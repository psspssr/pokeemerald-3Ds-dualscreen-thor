+/* The original read at gray[37] crossed its 16-color palette and the next
+ * 16-color palette into interface[5]. Address the actual asset explicitly. */
+static u16 FactorySwapFadeColor(void)
+{
+    const u16 *colors = sInterface_Pal;
+#ifdef PORT_BRIDGE
+    colors = Port_ResolveAssetPointer(colors);
+#endif
+    return colors[5];
+}
+
+/* INCBIN stubs do not describe the tileset's allocation or copy extent. */
+static u32 FactoryAssetSize(const void *asset, u32 embeddedSize)
+{
+#ifdef PORT_BRIDGE
+    u32 bytes = Port_GetAssetSizeExact(asset);
+    if (bytes != 0)
+        return bytes;
+#else
+    (void)asset;
+#endif
+    return embeddedSize;
+}
+
+#define FACTORY_ASSET_SIZE(asset) FactoryAssetSize(asset, sizeof(asset))
 
