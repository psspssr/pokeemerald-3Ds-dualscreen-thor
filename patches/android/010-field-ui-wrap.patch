+/* Field windows slide off the top of BG0 by scrolling its 256-row map.
+ * The GBA hides the wrapped copy below row160, but the 240-row viewport can
+ * show it again at the bottom. Clip only that second copy of field BG0;
+ * terrain and the deliberately repeating field-move banner retain wrapping.
+ * Both cached 2D layers and the voxel overlay's tile walk use this extent. */
+static int FieldUiBottom(unsigned bg, int bottom)
+{
+    if (bg == 0 && !sFieldBanner && (sFieldUi || sVoxelObjPass != VOXEL_OBJ_NONE))
+    {
+        unsigned height = (Reg(8) & 0x8000u) ? 512u : 256u;
+        unsigned scroll = Reg(0x12) & (height - 1);
+        int firstWrap = (int)(height - scroll);
+
+        if (bottom > firstWrap) bottom = firstWrap;
+    }
+    return bottom;
+}
