<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Emerald" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/emerald</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/emerald_light</item>
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
    </style>

    <style name="Theme.Emerald.Fullscreen">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
